# Copia para .env.local em dev, ou define estas variáveis nas Environment Variables do Vercel.

# Credenciais do Firebase (conta de serviço). Vêm do ficheiro JSON que descarregas em
# Firebase Console → Definições do projeto → Contas de serviço → Gerar nova chave privada.
FIREBASE_PROJECT_ID=o-teu-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@o-teu-project-id.iam.gserviceaccount.com
# Cola o campo "private_key" do JSON tal como vem (com as \n incluídas, entre aspas).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# A tua password de acesso à app. Só quem souber esta password entra em /leads e /calendario.
APP_PASSWORD=escolhe-uma-password-forte

# Segredo usado para assinar o cookie de sessão. Gera um valor aleatório e não o partilhes.
# Podes gerar um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=um-valor-aleatorio-longo
